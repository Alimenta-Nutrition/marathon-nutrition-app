# ---------------------------------------------------------------------------
# nutrition-api environment variables
# Copy to `.env` for local development (do NOT commit the real .env).
# NOTE: This service intentionally uses NON-prefixed vars. Do not reuse the
# NEXT_PUBLIC_* names from the Next.js frontend here.
# ---------------------------------------------------------------------------

# Supabase (server-side / admin access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required for validating Supabase access tokens in requireAuth middleware
SUPABASE_ANON_KEY=your-anon-key

# Set to 'true' after web and mobile clients are shipped with Bearer token support.
REQUIRE_AUTH=false

# OpenAI
OPENAI_API_KEY=sk-...

# USDA FoodData Central (local test: /api/test/meal-generation-comparison)
USDA_API_KEY=your-usda-api-key
# Meal model is set by ACTIVE_OPENAI_MEAL_MODEL in api/lib/aiCompletion.js (currently gpt-5.4-mini).
# Optional fallback only if that key is invalid:
# OPENAI_MEAL_MODEL=gpt-5.4-mini
# OPENAI_MEAL_MODEL=gpt-5.6-sol
# OPENAI_MEAL_MODEL=gpt-5.4-nano
# OPENAI_MEAL_MODEL=gpt-5-mini

# Google Gemini
GEMINI_API_KEY=your-gemini-key

# Sentry error monitoring. Optional locally; required in production to capture API errors.
SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/0000000

# ML prediction service (macro estimation)
ML_API_URL=https://alimenta-ml-service.onrender.com

# CORS: comma-separated list of allowed origins.
# Example: https://app.example.com,https://admin.example.com
# Leave empty to allow all origins (local dev only).
CORS_ORIGINS=

# HTTP port the service listens on
PORT=4000
